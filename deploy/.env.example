LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Hosts the sandboxes may reach through the egress proxy (suffix match: wikipedia.org covers
# en.wikipedia.org). The browser sandbox uses the same list, so a browsing task needs the sites
# it will visit here. Default: pypi.org,files.pythonhosted.org
# MINILOCKER_ALLOW=pypi.org,files.pythonhosted.org,wikipedia.org

# Artifact store: any S3-compatible endpoint. Unset = artifacts are simply not attached.
# Local development: ./deploy/dev-storage.sh starts one and prints these values.
# On the VM: Vultr Object Storage, e.g. https://ewr1.vultrobjects.com
MINILOCKER_S3_ENDPOINT=
MINILOCKER_S3_ACCESS_KEY=
MINILOCKER_S3_SECRET_KEY=
MINILOCKER_S3_BUCKET=minilocker-artifacts
MINILOCKER_S3_REGION=us-east-1

# Browser sandbox image (build once: see docs/week3-browser-artifacts.md)
# MINILOCKER_BROWSER_IMAGE=minilocker-browser:latest
